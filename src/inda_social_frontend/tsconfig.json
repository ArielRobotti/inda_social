{
  "compilerOptions": {
    // ... otras opciones
    "baseUrl": ".", // Es fundamental para que "paths" funcione
    "paths": {
      // Debe coincidir con la definición de tu components.json
      "@/lib/utils": [
        "src/lib/utils.ts" // O "src/lib/utils.tsx" dependiendo de tu archivo real
      ],
      // Asegúrate de que los otros alias también estén aquí, por ejemplo:
      "@/components/*": [
        "src/components/*"
      ]
      // Y si tienes el alias "utils": "@/lib/utils" como en tu components.json:
      // "@/lib/utils": [
      //   "src/lib/utils.ts" 
      // ]
    }
    // ...
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
